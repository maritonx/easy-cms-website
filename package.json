{
  "name": "easy-cms-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node --env-file-if-exists=.env.local scripts/fetch-docs.mjs --if-missing",
    "build": "next build",
    "prebuild": "node --env-file-if-exists=.env.local scripts/fetch-docs.mjs",
    "start": "next start",
    "lint": "eslint",
    "docs:fetch": "node --env-file-if-exists=.env.local scripts/fetch-docs.mjs",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.mts",
    "typecheck": "node --env-file-if-exists=.env.local scripts/fetch-docs.mjs --if-missing && next typegen && tsc --noEmit",
    "migrate:turso": "NODE_ENV=production node --env-file-if-exists=.env --env-file=.env.turso node_modules/easy-cms/bin/easy-cms.js migrate",
    "seed:turso": "NODE_ENV=production node --env-file-if-exists=.env --env-file=.env.turso --import tsx scripts/seed.mts"
  },
  "dependencies": {
    "@easy-cms/admin": "0.22.1",
    "@easy-cms/core": "^0.22.1",
    "@easy-cms/db-sqlite": "^0.22.1",
    "@easy-cms/next": "^0.22.1",
    "@easy-cms/richtext": "^0.22.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "easy-cms": "^0.22.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.1"
}
